<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android backends for MavUI.Essentials: SharedPreferences (Preferences) and an
    Android Keystore-protected store (SecureStorage). Targets API 21 (Android 5.0):
    no API above 21 is used. The app that hosts this library must set its own minSdk.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mav.Essentials.Droid</RootNamespace>
    <AssemblyName>MavUI.Essentials.Android</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MavUI.Essentials\MavUI.Essentials.csproj" />
  </ItemGroup>

</Project>
