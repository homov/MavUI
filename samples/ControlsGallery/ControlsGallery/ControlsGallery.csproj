<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared multi-platform UI (AXAML pages, shell and localization).
    The platform heads are sibling projects (samples/ControlsGallery/ControlsGallery.Desktop, .Android, .Browser) and reference this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mav.ControlsGallery</RootNamespace>
    <AssemblyName>Mav.ControlsGallery</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes)</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MavUI\MavUI.csproj" />
  </ItemGroup>

  <!--
    One set of languages for both galleries (this one and the markup one): the tables, the
    language catalog and the shared startup live outside both projects.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
