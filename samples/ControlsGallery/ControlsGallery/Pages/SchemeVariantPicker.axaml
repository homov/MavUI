<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mav="https://where.it/mav"
             xmlns:pages="clr-namespace:Mav.ControlsGallery.Pages"
             x:Class="Mav.ControlsGallery.Pages.SchemeVariantPicker">
  <mav:MavItems Wrap="True" x:Name="Choices">
    <mav:MavItems.ItemTemplate>
      <DataTemplate x:DataType="pages:SchemeVariantChoice">
        <mav:MavButton Variant="{Binding ButtonVariant}" Text="{Binding Label}" Margin="0,0,8,8"
                       Command="{x:Static pages:SchemeVariantPicker.Select}"
                       CommandParameter="{Binding Variant}" />
      </DataTemplate>
    </mav:MavItems.ItemTemplate>
  </mav:MavItems>
</UserControl>
