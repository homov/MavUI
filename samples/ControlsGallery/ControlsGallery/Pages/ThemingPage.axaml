<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mav="https://where.it/mav"
             xmlns:pages="clr-namespace:Mav.ControlsGallery.Pages"
             x:Class="Mav.ControlsGallery.Pages.ThemingPage">
  <mav:MavScrollViewer>
    <Border Padding="20,16,20,40">
      <StackPanel Spacing="18">

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Config.Title, Fallback=Configuration}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Config.Body, Fallback=All theme changes are global and rebuild the palette immediately.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="{mav:Loc Theming.Controls.Title, Fallback=Theme controls}" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Controls.CardBody, Fallback=Seed color\, mode\, palette\, contrast\, density\, motion and shape scale.}" />
              <StackPanel Spacing="8">
                <WrapPanel>
                  <mav:MavButton x:Name="ModeLightButton" Variant="Outlined" Icon="{x:Static mav:MavIcons.LightMode}" Text="{mav:Loc Overview.Mode.Light, Fallback=Light}" Command="{x:Static pages:ThemingPage.ModeLight}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="ModeDarkButton" Variant="Outlined" Icon="{x:Static mav:MavIcons.DarkMode}" Text="{mav:Loc Overview.Mode.Dark, Fallback=Dark}" Command="{x:Static pages:ThemingPage.ModeDark}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="ModeSystemButton" Variant="Outlined" Icon="{x:Static mav:MavIcons.SettingsBrightness}" Text="{mav:Loc Overview.Mode.System, Fallback=System}" Command="{x:Static pages:ThemingPage.ModeSystem}" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Indigo, Fallback=Indigo}" IsChecked="True" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Indigo}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Purple, Fallback=Purple}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Purple}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Blue, Fallback=Blue}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Blue}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Teal, Fallback=Teal}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Teal}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Green, Fallback=Green}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Green}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Orange, Fallback=Orange}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Orange}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Rose, Fallback=Rose}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Rose}" Margin="0,0,16,8" />
                  <mav:MavRadioButton GroupName="Seed" Label="{mav:Loc Overview.Seed.Slate, Fallback=Slate}" Command="{x:Static pages:ThemingPage.SetSeed}" CommandParameter="{x:Static mav:MavColors.Slate}" Margin="0,0,16,8" />
                </WrapPanel>
                <WrapPanel>
                  <mav:MavButton x:Name="ContrastStandardButton" Variant="Tonal" Text="{mav:Loc Theming.Contrast.Standard, Fallback=Contrast: Standard}" Command="{x:Static pages:ThemingPage.SetContrast}" CommandParameter="{x:Static mav:MavContrast.Standard}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="ContrastMediumButton" Variant="Tonal" Text="{mav:Loc Overview.Contrast.Medium, Fallback=Medium}" Command="{x:Static pages:ThemingPage.SetContrast}" CommandParameter="{x:Static mav:MavContrast.Medium}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="ContrastHighButton" Variant="Tonal" Text="{mav:Loc Overview.Contrast.High, Fallback=High}" Command="{x:Static pages:ThemingPage.SetContrast}" CommandParameter="{x:Static mav:MavContrast.High}" Margin="0,0,8,8" />
                </WrapPanel>
                  <pages:SchemeVariantPicker />
                <WrapPanel>
                  <mav:MavButton x:Name="DensityComfortableButton" Variant="Text" Text="{mav:Loc Overview.Density.Comfortable, Fallback=Comfortable}" Command="{x:Static pages:ThemingPage.SetDensity}" CommandParameter="{x:Static mav:MavDensity.Comfortable}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="DensityCompactButton" Variant="Text" Text="{mav:Loc Overview.Density.Compact, Fallback=Compact}" Command="{x:Static pages:ThemingPage.SetDensity}" CommandParameter="{x:Static mav:MavDensity.Compact}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="DensityDenseButton" Variant="Text" Text="{mav:Loc Overview.Density.Dense, Fallback=Dense}" Command="{x:Static pages:ThemingPage.SetDensity}" CommandParameter="{x:Static mav:MavDensity.Dense}" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                  <mav:MavButton x:Name="MotionExpressiveButton" Variant="Outlined" Text="{mav:Loc Theming.Motion.Expressive, Fallback=Motion: Expressive}" Command="{x:Static pages:ThemingPage.SetMotion}" CommandParameter="{x:Static mav:MavMotionScheme.Expressive}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="MotionStandardButton" Variant="Outlined" Text="{mav:Loc Overview.Motion.Standard, Fallback=Standard}" Command="{x:Static pages:ThemingPage.SetMotion}" CommandParameter="{x:Static mav:MavMotionScheme.Standard}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="MotionReducedButton" Variant="Outlined" Text="{mav:Loc Overview.Motion.Reduced, Fallback=Reduced}" Command="{x:Static pages:ThemingPage.SetMotion}" CommandParameter="{x:Static mav:MavMotionScheme.Reduced}" Margin="0,0,8,8" />
                  <mav:MavButton x:Name="MotionNoneButton" Variant="Outlined" Text="{mav:Loc Theming.Motion.None, Fallback=None}" Command="{x:Static pages:ThemingPage.SetMotion}" CommandParameter="{x:Static mav:MavMotionScheme.None}" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                  <mav:MavButton Variant="Tonal" Text="{mav:Loc Theming.Shape.Compact, Fallback=Shape: Compact}" Command="{x:Static pages:ThemingPage.SetShape}" CommandParameter="{x:Static mav:MavShapeScale.Compact}" Margin="0,0,8,8" />
                  <mav:MavButton Variant="Tonal" Text="{mav:Loc Overview.Motion.Standard, Fallback=Standard}" Command="{x:Static pages:ThemingPage.SetShape}" CommandParameter="{x:Static mav:MavShapeScale.Standard}" Margin="0,0,8,8" />
                  <mav:MavButton Variant="Tonal" Text="{mav:Loc Theming.Shape.Expressive, Fallback=Expressive}" Command="{x:Static pages:ThemingPage.SetShape}" CommandParameter="{x:Static mav:MavShapeScale.Expressive}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="MavTheme.Configure(seed, mode, schemeVariant, contrast, density, motion, shapeScale)" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Colors.Title, Fallback=Color roles}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Colors.Body, Fallback=Every MD3 color role for the current scheme.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="MavColorRole" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Colors.CardBody, Fallback=Each swatch shows the role name over its own color.}" />
              <ItemsControl x:Name="ColorItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:ThemeSample">
                    <Border Width="132" Height="64" CornerRadius="12" Padding="10" Margin="0,0,8,8" Background="{Binding Background}">
                      <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" Foreground="{Binding Foreground}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="MavTheme.ColorOf(role) · MavTheme.BrushOf(color)" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Type.Title, Fallback=Type scale}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Type.Body, Fallback=15 roles; MavLabel applies the font\, size\, weight and line height.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="MavTypeRole" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Type.CardBody, Fallback=Every role rendered with its own style.}" />
              <ItemsControl ItemsSource="{x:Static pages:ThemingPage.TypeScale}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:ThemeSample">
                    <mav:MavLabel Role="{Binding Role}" Text="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="new MavLabel { Role = MavTypeRole.TitleLarge }" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Shape.Title, Fallback=Shape and elevation}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Shape.Body, Fallback=Corner radius tokens and the five elevation levels.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="MavShape and MavSurface.Elevation" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Shape.CardBody, Fallback=Shape tokens follow MavShapeScale; elevation uses two-layer shadows.}" />
              <StackPanel Spacing="8">
                <ItemsControl x:Name="ShapeItems">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:ThemeSample">
                      <Border Width="120" Height="64" Margin="0,0,8,8" CornerRadius="{Binding Corner}" Background="{DynamicResource Md.Brush.SecondaryContainer}">
                        <mav:MavLabel Text="{Binding Name}" Role="LabelSmall" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Static pages:ThemingPage.ElevationSamples}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:ThemeSample">
                      <mav:MavSurface Width="120" Height="72" Margin="0,0,8,8" Radius="12" Elevation="{Binding Elevation}" FillColor="{DynamicResource Md.Color.SurfaceContainerLow}">
                        <mav:MavLabel Text="{Binding Name}" Role="LabelSmall" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </mav:MavSurface>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="MavTheme.Current.Shape · MavSurface.Elevation" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Contrast.Title, Fallback=Contrast}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Contrast.Body, Fallback=WCAG 2.1 ratios for common role pairs via MavAccessibility.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="MavAccessibility.ContrastRatio" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Contrast.CardBody, Fallback=Ratios are computed from the current scheme.}" />
              <ItemsControl x:Name="ContrastItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <mav:MavLabel Role="BodySmall" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="MavAccessibility.ContrastRatio(foreground, background)" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

        <StackPanel Spacing="12">
          <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Localization.Title, Fallback=Localization}" />
          <mav:MavLabel Role="BodyMedium" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Localization.Body, Fallback=Switch language with one call; no event subscriptions and no manual text reassignment.}" />
          <mav:MavCard Variant="Outlined" CardPadding="16">
            <StackPanel Spacing="10">
              <mav:MavLabel Role="TitleMedium" Text="{mav:Loc Theming.Language.Title, Fallback=Language switch}" />
              <mav:MavLabel Role="BodySmall" Secondary="True" TextWrapping="Wrap" Text="{mav:Loc Theming.Language.CardBody, Fallback=The greeting and dialog labels use the same provider. The language buttons call SetCulture; attached texts update automatically\, without event handlers.}" />
              <StackPanel Spacing="8">
                <mav:MavLabel Role="HeadlineSmall" Text="{mav:Loc Theming.Greeting, Fallback=Hello}" />
                <WrapPanel>
                  <mav:MavButton Variant="Outlined" Text="English" Command="{x:Static pages:ThemingPage.SetEnglish}" Margin="0,0,8,8" />
                  <mav:MavButton Variant="Outlined" Text="Русский" Command="{x:Static pages:ThemingPage.SetRussian}" Margin="0,0,8,8" />
                  <mav:MavButton Variant="Filled" Text="{mav:Loc Theming.Lang.OpenDialog, Fallback=Open dialog}" Margin="0,0,8,8">
                    <mav:MavFlyout.Dialog>
                      <mav:MavDialog Title="{mav:Loc Theming.Dialog.Title, Fallback=Delete project?}"
                                     Message="{mav:Loc Theming.Dialog.Message, Fallback=This action cannot be undone.}"
                                     DismissText="{x:Static mav:MavLocalization.Cancel}" />
                    </mav:MavFlyout.Dialog>
                  </mav:MavButton>
                </WrapPanel>
              </StackPanel>
              <mav:MavLabel Role="LabelSmall" Secondary="True" TextWrapping="Wrap" Text="MavLocalization.SetCulture(new CultureInfo(&quot;ru-RU&quot;)) · {mav:Loc Key, Fallback=...}" />
            </StackPanel>
          </mav:MavCard>
        </StackPanel>

      </StackPanel>
    </Border>
  </mav:MavScrollViewer>
</UserControl>
