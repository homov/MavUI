<mav:MavWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mav="https://where.it/mav"
                xmlns:shell="clr-namespace:Mav.ControlsGallery.Shell"
                x:Class="Mav.ControlsGallery.MainWindow"
                Title="{mav:Loc Shell.WindowTitle, Fallback=Mav Controls Gallery}"
                Width="1320"
                Height="900"
                MinWidth="360"
                MinHeight="480">
  <shell:MainView />
</mav:MavWindow>
