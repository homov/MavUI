<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Markup version of the controls gallery. The UI is written in C# with the fluent methods generated by
    AMarkup (markup/src). No XAML is used in this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mav.ControlsGalleryMarkup</RootNamespace>
    <AssemblyName>Mav.ControlsGalleryMarkup</AssemblyName>
    <!-- Generated fluent setters for nullable value types unbox without a check (same as AMarkup.Controls). -->
    <NoWarn>$(NoWarn);CS8605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MavUI\MavUI.csproj" />
    <ProjectReference Include="..\..\..\markup\src\AMarkup.Controls\AMarkup.Controls.csproj" />
    <!-- Generates fluent setters for MavUI controls at build time. -->
    <ProjectReference Include="..\..\..\markup\src\AMarkup.Generators\AMarkup.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
