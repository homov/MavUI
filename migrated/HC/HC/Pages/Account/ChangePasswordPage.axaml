<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Account.ChangePasswordPage"
                    Title="{mav:Loc password.change.title, Fallback=Change password}">
  <mav:MavContentPage.Content>
    <mav:MavScrollViewer>
      <StackPanel Margin="20,24,20,40" Spacing="16" MaxWidth="480">
        <mav:MavLabel Role="BodyMedium" TextWrapping="Wrap"
                      Text="{mav:Loc password.change.hint, Fallback=Enter the current password and the new one.}" />
        <mav:MavTextField x:Name="CurrentField" Variant="Outlined" IsPassword="True"
                          Label="{mav:Loc password.field.current, Fallback=Current password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavTextField x:Name="NewField" Variant="Outlined" IsPassword="True"
                          Label="{mav:Loc auth.field.newpassword, Fallback=New password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavTextField x:Name="RepeatField" Variant="Outlined" IsPassword="True"
                          Label="{mav:Loc password.field.repeat, Fallback=Repeat new password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavBanner x:Name="ErrorBanner" Icon="{x:Static mav:MavIcons.Error}" IsVisible="False" />
        <mav:MavButton x:Name="SaveButton" Variant="Filled" HorizontalAlignment="Stretch"
                       Text="{mav:Loc password.change.save, Fallback=Save new password}" />
      </StackPanel>
    </mav:MavScrollViewer>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
