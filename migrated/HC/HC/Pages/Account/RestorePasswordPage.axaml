<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Account.RestorePasswordPage"
                    Title="{mav:Loc auth.restore.title, Fallback=Restore password}">
  <mav:MavContentPage.Content>
    <mav:MavScrollViewer>
      <StackPanel Margin="20,24,20,40" Spacing="16" MaxWidth="480">
        <mav:MavTextField x:Name="EmailField" Variant="Outlined"
                          Label="{mav:Loc auth.field.email, Fallback=Email}"
                          LeadingIcon="{x:Static mav:MavIcons.Email}" />
        <mav:MavInfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                        Title="{mav:Loc error.title, Fallback=Error}" />
        <mav:MavButton x:Name="SendButton" Variant="Filled" HorizontalAlignment="Stretch"
                       Text="{mav:Loc auth.restore.button, Fallback=Send code}" />
      </StackPanel>
    </mav:MavScrollViewer>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
