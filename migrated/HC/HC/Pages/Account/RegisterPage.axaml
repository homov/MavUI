<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Account.RegisterPage"
                    Title="{mav:Loc auth.register.title, Fallback=Create account}">
  <mav:MavContentPage.Content>
    <mav:MavScrollViewer>
      <StackPanel Margin="20,24,20,40" Spacing="16" MaxWidth="480">
        <mav:MavTextField x:Name="EmailField" Variant="Outlined"
                          Label="{mav:Loc auth.field.email, Fallback=Email}"
                          LeadingIcon="{x:Static mav:MavIcons.Email}" />
        <mav:MavTextField x:Name="PasswordField" Variant="Outlined" IsPassword="True"
                          Label="{mav:Loc auth.field.password, Fallback=Password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavTextField x:Name="RepeatField" Variant="Outlined" IsPassword="True"
                          Label="{mav:Loc auth.field.password2, Fallback=Repeat password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavInfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                        Title="{mav:Loc error.title, Fallback=Error}" />
        <mav:MavButton x:Name="CreateButton" Variant="Filled" HorizontalAlignment="Stretch"
                       Text="{mav:Loc auth.register.button, Fallback=Create account}" />
      </StackPanel>
    </mav:MavScrollViewer>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
