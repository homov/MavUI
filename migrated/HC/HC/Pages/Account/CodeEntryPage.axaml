<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Account.CodeEntryPage"
                    Title="{mav:Loc auth.code.title, Fallback=Enter code}">
  <mav:MavContentPage.Content>
    <mav:MavScrollViewer>
      <StackPanel Margin="20,24,20,40" Spacing="16" MaxWidth="480">
        <mav:MavLabel x:Name="HintLabel" Role="BodyMedium" TextWrapping="Wrap" />
        <mav:MavPinInput x:Name="CodeInput" Length="4" HorizontalAlignment="Center" />
        <mav:MavTextField x:Name="NewPasswordField" Variant="Outlined" IsPassword="True" IsVisible="False"
                          Label="{mav:Loc auth.field.newpassword, Fallback=New password}"
                          LeadingIcon="{x:Static mav:MavIcons.Lock}" />
        <mav:MavInfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                        Title="{mav:Loc error.title, Fallback=Error}" />
        <mav:MavButton x:Name="ConfirmButton" Variant="Filled" HorizontalAlignment="Stretch" />
      </StackPanel>
    </mav:MavScrollViewer>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
