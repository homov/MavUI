<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Shell.StartPage"
                    Title="HC">
  <mav:MavContentPage.Content>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24">
      <mav:MavLinearProgress IsIndeterminate="True" Width="200" />
      <mav:MavLabel Role="BodyMedium" HorizontalAlignment="Center"
                    Text="{mav:Loc startup.checking, Fallback=Signing you in...}" />
    </StackPanel>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
