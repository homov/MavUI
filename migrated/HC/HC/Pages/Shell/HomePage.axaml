<mav:MavContentPage xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mav="https://where.it/mav"
                    x:Class="Hc.Pages.Shell.HomePage"
                    Title="{mav:Loc home.title, Fallback=HC}">
  <mav:MavContentPage.Content>
    <StackPanel Margin="20,24,20,40" Spacing="16" MaxWidth="480" VerticalAlignment="Center">
      <mav:MavLabel Role="BodyLarge" HorizontalAlignment="Center" TextWrapping="Wrap"
                    Text="{mav:Loc home.placeholder, Fallback=Groups and devices will appear here.}" />
      <mav:MavButton x:Name="SignOutButton" Variant="Outlined" HorizontalAlignment="Stretch"
                     Text="{mav:Loc home.signout, Fallback=Sign out}" />
    </StackPanel>
  </mav:MavContentPage.Content>
</mav:MavContentPage>
