<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux SecureStorage backend for MavUI.Essentials. Uses libsecret through the secret-tool command
    (package libsecret-tools) and any Secret Service provider (GNOME Keyring, KeePassXC, ...).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mav.Essentials.Linux</RootNamespace>
    <AssemblyName>MavUI.Essentials.Linux</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MavUI.Essentials\MavUI.Essentials.csproj" />
  </ItemGroup>

</Project>
