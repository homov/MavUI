<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mav.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests/MavUI.VisualTests is its own project (Skia + real drawing). The default items of
         this project would otherwise compile its files too. -->
    <Compile Remove="MavUI.VisualTests/**" />
    <EmbeddedResource Remove="MavUI.VisualTests/**" />
    <AvaloniaResource Remove="MavUI.VisualTests/**" />
    <None Remove="MavUI.VisualTests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MavUI\MavUI.csproj" />
    <ProjectReference Include="..\samples\ControlsGallery\ControlsGallery\ControlsGallery.csproj" />
    <ProjectReference Include="..\MavUI.Essentials\MavUI.Essentials.csproj" />
  </ItemGroup>
</Project>
