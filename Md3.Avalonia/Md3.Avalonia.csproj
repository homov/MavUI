<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <RootNamespace>Md3.Avalonia</RootNamespace>
    <AssemblyName>Md3.Avalonia</AssemblyName>
    <PackageId>Md3.Avalonia</PackageId>
    <Version>0.1.0</Version>
    <Description>Material Design 3 component library for Avalonia in pure C# (no AXAML).</Description>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      Icon font sets embedded into the assembly:
        all      - Roboto + Material Symbols + Material Icons + Material Design Icons (default)
        no-mdi   - everything except the 1.24 MB Material Design Icons set
        minimal  - Roboto + Material Symbols Rounded only (smallest)
      Icons from an excluded set will not render; pick the set that covers MdIcons used by the app.
    -->
    <Md3Fonts Condition="'$(Md3Fonts)' == ''">all</Md3Fonts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Fonts\Roboto-Regular.ttf" />
    <AvaloniaResource Include="Resources\Fonts\MaterialSymbolsRounded.ttf"
                      Condition="'$(Md3Fonts)' != 'roboto'" />
    <AvaloniaResource Include="Resources\Fonts\MaterialIcons-Regular.ttf"
                      Condition="'$(Md3Fonts)' == 'all' or '$(Md3Fonts)' == 'no-mdi'" />
    <AvaloniaResource Include="Resources\Fonts\MaterialDesignIcons.ttf"
                      Condition="'$(Md3Fonts)' == 'all'" />
  </ItemGroup>

</Project>
