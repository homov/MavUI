<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="HeatController.CardView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="self">
    <ContentView.Content>
        <Grid>
            <Frame
                Padding="0"
                BackgroundColor="{Binding BodyBackgroundColor, Source={Reference self}}"
                BorderColor="{Binding HeaderBackgroundColor, Source={Reference self}}"
                CornerRadius="6"
                HasShadow="False">
                <Grid
                    ColumnSpacing="0"
                    RowDefinitions="Auto, *"
                    RowSpacing="0">
                    <BoxView
                        x:Name="HeadBoxView"
                        Grid.Row="0"
                        Margin="0"
                        BackgroundColor="{Binding HeaderBackgroundColor, Source={Reference self}}"
                        CornerRadius="6"
                        HeightRequest="{Binding HeaderHeight, Source={Reference self}}" />
                    <ContentView
                        Grid.Row="0"
                        Padding="10,0"
                        Content="{Binding Header, Source={Reference self}}"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="CenterAndExpand" />
                    <ContentView
                        Grid.Row="1"
                        Margin="2,0,2,4"
                        Padding="8,0"
                        BackgroundColor="{Binding BodyBackgroundColor, Source={Reference self}}"
                        Content="{Binding Body, Source={Reference self}}"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </Grid>
            </Frame>
        </Grid>
    </ContentView.Content>
</ContentView>