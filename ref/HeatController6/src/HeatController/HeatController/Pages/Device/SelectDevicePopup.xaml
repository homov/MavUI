<xct:Popup
    x:Class="HeatController.SelectDevicePopup"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:HeatController"
    xmlns:m="clr-namespace:HeatController.Models"
    xmlns:t="clr-namespace:Xamarin.CommunityToolkit.Extensions;assembly=Xamarin.CommunityToolkit"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="self"
    x:DataType="l:SelectDeviceViewModel"
    Size="320,400">
    <Grid
        Padding="10"
        BackgroundColor="{DynamicResource GrayBg}"
        HorizontalOptions="Center"
        RowDefinitions="Auto,*,Auto"
        VerticalOptions="Center">
        <Label
            Padding="0,0,0,10"
            FontFamily="{Static l:Fonts.MonsterratSemiBold}"
            FontSize="18"
            HorizontalOptions="Center"
            Text="{t:Translate SelectDevice}"
            VerticalOptions="Center" />
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Devices}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout
                        Margin="0,0,0,15"
                        x:DataType="m:UserDevice"
                        xct:TouchEffect.Command="{Binding OkCommand, Source={Reference self}}"
                        xct:TouchEffect.CommandParameter="{Binding .}"
                        xct:TouchEffect.NativeAnimation="True"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Image
                            HeightRequest="30"
                            Source="{Binding Info.ImageUrl}"
                            WidthRequest="30" />
                        <StackLayout
                            Orientation="Vertical"
                            Spacing="0"
                            VerticalOptions="CenterAndExpand">
                            <Label
                                Text="{Binding Info.DeviceName}"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="10"
                                IsVisible="{Binding Info.HasGroup}"
                                Text="{Binding Location.Name}"
                                TextColor="{DynamicResource PrimaryLight}" />
                        </StackLayout>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <StackLayout
            Grid.Row="2"
            HorizontalOptions="End"
            Orientation="Horizontal"
            Spacing="10"
            VerticalOptions="CenterAndExpand">
            <Label
                Padding="10"
                xct:TouchEffect.Command="{Binding CancelCommand, Source={Reference self}}"
                xct:TouchEffect.CommandParameter="{Binding .}"
                xct:TouchEffect.NativeAnimation="True"
                HorizontalOptions="End"
                Style="{DynamicResource LinkLabel}"
                Text="{t:Translate Cancel}"
                TextTransform="Uppercase"
                VerticalOptions="Center" />
        </StackLayout>
    </Grid>
</xct:Popup>