<?xml version="1.0" encoding="utf-8" ?>
<l:BasePage
    x:Class="HeatController.ChangePasswordPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:il="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:l="clr-namespace:HeatController"
    xmlns:t="clr-namespace:Xamarin.CommunityToolkit.Extensions;assembly=Xamarin.CommunityToolkit"
    Title="{t:Translate ChangePassword}"
    x:DataType="l:ChangePasswordPageViewModel"
    IsBusy="{Binding IsBusy}">
    <l:BasePage.Body>
        <ScrollView>
            <StackLayout Margin="20" Spacing="0">
                <StackLayout Margin="0,10,0,20">
                    <Label Text="{t:Translate EnterCurrentPasswordAndNew}" />
                </StackLayout>

                <StackLayout>
                    <Label Text="{t:Translate CurrentPassword}" />
                    <il:SfTextInputLayout>
                        <Entry IsPassword="True" Text="{Binding CurrentPassword}" />
                    </il:SfTextInputLayout>

                    <Label Text="{t:Translate NewPassword}" />
                    <il:SfTextInputLayout EnablePasswordVisibilityToggle="True">
                        <Entry IsPassword="True" Text="{Binding NewPassword}" />
                    </il:SfTextInputLayout>

                    <Label Text="{t:Translate ConfirmPassword}" />
                    <il:SfTextInputLayout EnablePasswordVisibilityToggle="True">
                        <Entry IsPassword="True" Text="{Binding ConfirmPassword}" />
                    </il:SfTextInputLayout>
                </StackLayout>

                <Button
                    Margin="0,15"
                    Command="{Binding SaveCommand}"
                    Text="{t:Translate SaveNewPassword}" />

            </StackLayout>
        </ScrollView>
    </l:BasePage.Body>
</l:BasePage>