<?xml version="1.0" encoding="utf-8" ?>
<l:BasePage
    x:Class="HeatController.RestorePasswordPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:il="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:l="clr-namespace:HeatController"
    xmlns:t="clr-namespace:Xamarin.CommunityToolkit.Extensions;assembly=Xamarin.CommunityToolkit"
    IsBusy="{Binding IsBusy}"
    Title="{t:Translate RestorePassword}"
    x:DataType="l:RestorePasswordPageViewModel">
    <l:BasePage.Body>
        <ScrollView>
            <StackLayout Margin="20">

                <StackLayout Margin="0,10,0,20">
                    <Label Text="{t:Translate CheckEmailEnterCode}" />
                </StackLayout>

                <StackLayout>
                    <Label Text="{t:Translate Code}" />
                    <il:SfTextInputLayout>
                        <Entry
                            Margin="10,0"
                            Keyboard="Numeric"
                            Text="{Binding Code}" />
                    </il:SfTextInputLayout>

                    <Label Text="{t:Translate Password}" />
                    <il:SfTextInputLayout EnablePasswordVisibilityToggle="True">
                        <Entry
                            IsPassword="True"
                            Text="{Binding Password}"
                            VerticalOptions="EndAndExpand" />
                    </il:SfTextInputLayout>

                    <Label Text="{t:Translate ConfirmPassword}" />
                    <il:SfTextInputLayout EnablePasswordVisibilityToggle="True">
                        <Entry
                            IsPassword="True"
                            Text="{Binding ConfirmPassword}"
                            VerticalOptions="EndAndExpand" />
                    </il:SfTextInputLayout>

                </StackLayout>

                <Button
                    Margin="0,15"
                    Command="{Binding SaveCommand}"
                    Text="{t:Translate SaveNewPassword}" />

            </StackLayout>
        </ScrollView>
    </l:BasePage.Body>
</l:BasePage>